# Copy to .env on the server and fill in. Never commit .env.

# Postgres password for the app's database user. Generate one, e.g. openssl rand -base64 24
POSTGRES_PASSWORD=

# What Caddy serves on.
#   :80                      -> plain HTTP, reachable by the VM's public IP (no domain needed)
#   pistol.example.com       -> automatic HTTPS via Let's Encrypt (DNS must point at the VM first)
SITE_ADDRESS=:80

# Optional. Without it, photo upload still works but score-sheet extraction
# returns extractionError "no_api_key". Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
